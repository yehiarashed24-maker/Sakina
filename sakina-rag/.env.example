# Sakina AI Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=sakina
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
OPENROUTER_MODELS=openrouter/auto
BACKEND_URL=http://localhost:8000
CHROMA_DB_DIR=./chroma_db
LOCAL_VECTOR_STORE_DIR=../data/vector_store
